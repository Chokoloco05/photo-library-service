{
  "uid": "clair",
  "title": "Clair — supervision des services",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "description": "Métriques HTTP et Node.js réelles sur Docker Desktop. Collecte toutes les 15 secondes, historique persistant limité à sept jours et à 1 Go.",
  "tags": [
    "clair",
    "photo-service",
    "kubernetes"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "links": [
    {
      "title": "Scaling dans Headlamp",
      "url": "http://dashboard.localhost/",
      "type": "link",
      "targetBlank": true
    },
    {
      "title": "Cibles Prometheus",
      "url": "http://prometheus.localhost/targets",
      "type": "link",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environnement",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "clair-prometheus"
        },
        "query": "label_values(photo_app_info, environment)",
        "definition": "label_values(photo_app_info, environment)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Instances joignables",
      "description": "Instances dont le serveur de métriques répond. Le panneau PostgreSQL précise leur accès à la base.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "clair-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"photo-service\",environment=~\"$environment\"}) or vector(0)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "clair-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "En attente",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Accès PostgreSQL",
      "description": "Chaque instance exécute SELECT 1, avec un délai de deux secondes. La valeur minimale signale une instance en difficulté.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "clair-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(photo_database_up{job=\"photo-service\",environment=~\"$environment\"})",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "clair-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "En attente",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Indisponible",
                  "color": "red"
                },
                "1": {
                  "text": "Disponible",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Requêtes par seconde",
      "description": "Requêtes réelles hors sondes de démarrage, de readiness et de liveness.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "clair-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(photo_http_requests_total{job=\"photo-service\",environment=~\"$environment\",route!~\"/healthz|/readyz\"}[$__rate_interval]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "clair-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "En attente",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Erreurs serveur",
      "description": "Part des réponses HTTP 5xx dans le trafic applicatif observé.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "clair-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(photo_http_requests_total{job=\"photo-service\",environment=~\"$environment\",route!~\"/healthz|/readyz\",status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(photo_http_requests_total{job=\"photo-service\",environment=~\"$environment\",route!~\"/healthz|/readyz\"}[$__rate_interval])), 0.000001)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "clair-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "En attente",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Trafic HTTP par environnement",
      "description": "Le générateur de trafic local appelle les statistiques de Dev et Test. Les premiers taux nécessitent plusieurs collectes.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "clair-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (environment) (rate(photo_http_requests_total{job=\"photo-service\",environment=~\"$environment\",route!~\"/healthz|/readyz\"}[$__rate_interval]))",
          "legendFormat": "{{environment}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "clair-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "En attente",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Temps de réponse p95",
      "description": "Estimation du 95e percentile calculée à partir des histogrammes HTTP. Les sondes Kubernetes sont exclues.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "clair-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, environment) (rate(photo_http_request_duration_seconds_bucket{job=\"photo-service\",environment=~\"$environment\",route!~\"/healthz|/readyz\"}[$__rate_interval])))",
          "legendFormat": "{{environment}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "clair-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "En attente",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "CPU Node.js par instance",
      "description": "Temps CPU du processus Node.js exprimé en cœurs utilisés. Les noms des Pods permettent de suivre un rollout ou un scaling.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "clair-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(photo_process_cpu_seconds_total{job=\"photo-service\",environment=~\"$environment\"}[$__rate_interval])",
          "legendFormat": "{{environment}} / {{pod}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "clair-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "color": {
            "mode": "palette-classic"
          },
