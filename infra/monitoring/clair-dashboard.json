          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "title": "Accès PostgreSQL par environnement",
      "description": "1 indique que toutes les instances observées de cet environnement accèdent à PostgreSQL. 0 indique au moins un échec.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "clair-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (environment) (photo_database_up{job=\"photo-service\",environment=~\"$environment\"})",
          "legendFormat": "{{environment}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "clair-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
