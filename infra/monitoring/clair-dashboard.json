    },
    {
      "id": 9,
      "title": "Réponses HTTP par statut",
      "description": "Répartition du trafic par statut. Un import anonyme produit une réponse 401, un incident serveur une réponse 5xx.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "clair-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (environment, status_code) (rate(photo_http_requests_total{job=\"photo-service\",environment=~\"$environment\",route!~\"/healthz|/readyz\"}[$__rate_interval]))",
          "legendFormat": "{{environment}} / HTTP {{status_code}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
